import os
import subprocess
import time
from multiprocessing import Process, Manager, Event

# عدد العمليات المتوازية (يمكنك تغييره حسب عدد أنوية CPU أو عدد GPUs)
NUM_PROCESSES = 4

# النطاق المطلوب
start_range = int("0000000000000000000000008000000000000000000000000000000000000000", 16)
end_range   = int("000000000000000000000000ffffffffffffffffffffffffffffffffffffffff", 16)

# المسارات
KEYHUNT_BINARY = "./keyhunt"  # المسار إلى ملف keyhunt
TARGET_FILE = "target.txt"    # يجب أن يحتوي على المفتاح العام الهدف

def split_range(start, end, parts):
    step = (end - start) // parts
    ranges = []
    for i in range(parts):
        r_start = start + (i * step)
        r_end = start + ((i + 1) * step) - 1 if i < parts - 1 else end
        ranges.append((r_start, r_end))
    return ranges

def run_keyhunt_worker(start_int, end_int, stop_event, result_dict, worker_id):
    start_hex = format(start_int, '064x')
    end_hex = format(end_int, '064x')

    output_file = f"output_worker_{worker_id}.txt"

    cmd = [
        KEYHUNT_BINARY,
        '-m', 'pubkey',
        '-f', TARGET_FILE,
        '-s', start_hex,
        '-e', end_hex,
        '-o', output_file,
        '-b', 'GPU'  # أو 'CPU' إذا كنت تعمل على المعالج
    ]

    process = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    while not stop_event.is_set():
        if os.path.exists(output_file):
            with open(output_file, 'r') as f:
                lines = f.readlines()
                for line in lines:
                    if line.startswith("Privkey"):
                        result_dict['key'] = line.strip()
                        stop_event.set()
                        break
            break
        time.sleep(1)

    if process.poll() is None:
        process.kill()
    try:
        os.remove(output_file)
    except:
        pass

if __name__ == '__main__':
    manager = Manager()
    result_dict = manager.dict()
    stop_event = Event()

    ranges = split_range(start_range, end_range, NUM_PROCESSES)
    processes = []

    for i, (r_start, r_end) in enumerate(ranges):
        p = Process(target=run_keyhunt_worker, args=(r_start, r_end, stop_event, result_dict, i))
        processes.append(p)
        p.start()

    for p in processes:
        p.join()

    if 'key' in result_dict:
        print("\n✅ مفتاح خاص تم العثور عليه:")
        print(result_dict['key'])
    else:
        print("\n❌ لم يتم العثور على المفتاح في هذا النطاق.")
